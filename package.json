{
  "name": "wouter-compiles-it-blog",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore _site --ignore vendor",
    "lint:md:fix": "markdownlint \"**/*.md\" --fix --ignore node_modules --ignore _site --ignore vendor",
    "sync:mermaid": "node -e \"const v=require('./node_modules/mermaid/package.json').version;require('fs').writeFileSync('_data/mermaid.yml','version: '+v+'\\n');\""
  },
  "devDependencies": {
    "markdownlint-cli": "^0.45.0"
  },
  "dependencies": {
    "mermaid": "^11.0.0"
  }
}
