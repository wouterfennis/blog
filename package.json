{
  "name": "wouter-compiles-it-blog",
  "private": true,
  "scripts": {
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore _site --ignore vendor",
    "lint:md:fix": "markdownlint \"**/*.md\" --fix --ignore node_modules --ignore _site --ignore vendor",
    "sync:mermaid": "node -e \"const v=require('./node_modules/mermaid/package.json').version;require('fs').writeFileSync('_data/mermaid.yml','version: '+v+'\\n');\"",
    "check:post": "node .claude/scripts/check-post.mjs",
    "posts:index": "node .claude/scripts/posts-index.mjs",
    "images:optimize": "node .claude/scripts/optimize-images.mjs",
    "check:site": "node .claude/scripts/check-site.mjs"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "mermaid": "^12.1.0"
  },
  "overrides": {
    "js-yaml": "^5.4.3",
    "katex": "^0.19.0",
    "smol-toml": "^1.9.1"
  }
}
