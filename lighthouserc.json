{
  "ci": {
    "collect": {
      "staticDistDir": "_site",
      "url": [
        "/index.html",
        "/2023/04/19/sql-server-authentication-and-authorization-on-azure-with-managed-identities/index.html",
        "/2026/03/29/migrate-your-blog-towards-github-pages/index.html",
        "/tags/dotnet/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
